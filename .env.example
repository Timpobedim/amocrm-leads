# Адрес аккаунта amoCRM
AMO_BASE_URL=https://school.amocrm.ru

# Вариант 1 (проще): долгосрочный токен частной интеграции — срок от суток до пяти лет
AMO_LONG_LIVED_TOKEN=

# Вариант 2: OAuth. Данные интеграции, затем один раз: amo-leads authorize <код>
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_REDIRECT_URI=
AMO_TOKENS_FILE=data/amo-tokens.json

# Воронка для заявок (пусто — основная), очередь и частота досылки
AMO_PIPELINE_ID=
AMO_DATABASE=data/submissions.sqlite3
AMO_RETRY_EVERY=60
AMO_TIMEZONE=Europe/Moscow
